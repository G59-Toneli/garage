# Copy to .env and adjust. Never commit .env — see ADR-0001 (no managed services, no secrets in VCS).
# Compose loads this file; the application itself reads only the process environment.
# Every value below already has a working default, so `docker compose up` works without a .env.

# Credentials the postgres container initialises itself with.
POSTGRES_USER=garage
POSTGRES_PASSWORD=garage
POSTGRES_DB=garage

# Postgres, as reached from the application container. Compose derives this from the three
# variables above unless you override it here.
# GARAGE_DATABASE_URL=postgresql://garage:garage@postgres:5432/garage

# The manifest the service checks the database against at boot (ADR-0002). Only the catalogue is
# read, so pointing this at a real Corpus does not require mounting the material into the container.
# GARAGE_CORPUS_DIR=corpus/fixture

# Where the precomputed showcase records live. The service checks every one of them against the
# artifact at boot and refuses to start on a mismatch, exactly as it does for the Corpus above — a
# precomputed answer over material this database does not hold cites chunks nobody can check.
# Unset means the repository's own eval/showcase/. See docs/showcase.md.
# GARAGE_SHOWCASE_DIR=eval/showcase

# The baseline embedder, a build-time axis (ADR-0005). `baseline` is the default and is what the
# dense retriever searches; `none` builds a lexical-only artifact with no vectors and no dense arm,
# which is a declaration rather than an absence. Fetch the weights once with
# `python -m garage embedder fetch` — they are 470 MB, sha256-pinned, and never committed to git.
# GARAGE_EMBEDDER=baseline
# Where those weights live. Defaults to ~/.cache/garage/embedders/multilingual-e5-small; the
# container image sets it to /opt/garage/embedder, where the Dockerfile bakes them in.
# GARAGE_EMBEDDER_DIR=

# Generation is optional. With no key the service still boots, retrieves, traces and answers with
# the chunks alone — only the `answer` field and the `generate` span go missing. Install the extra
# to use it: `pip install -e .[gemini]`.
# GARAGE_GEMINI_API_KEY=
# GARAGE_GEMINI_MODEL=gemini-2.5-flash

# Bind address for the ASGI server. GARAGE_PORT also picks the published host port.
GARAGE_HOST=0.0.0.0
GARAGE_PORT=8000

# ------------------------------------------------------------------------------------------------
# The public deployment. Nothing below is needed on a laptop — every value has a default that is
# correct there. They exist because the ARM VM puts a paid provider's free tier behind a URL anyone
# can open. `docs/deploy.md` argues each number; `deploy/compose.prod.yaml` sets the ones that are
# properties of that overlay rather than of the operator's taste.
# ------------------------------------------------------------------------------------------------

# The domain Caddy obtains a certificate for, and the address Let's Encrypt sends expiry warnings to.
# Required by the production overlay and by nothing else. The domain is not decided yet (issue #15
# — it costs money), which is exactly why it is a variable and not a line in the Caddyfile.
# GARAGE_DOMAIN=garage.example.org
# ACME_EMAIL=you@example.org

# Whether X-Forwarded-For may be believed. Leave this OFF unless a reverse proxy you control is
# setting it. On the open internet that header is a string the client chose, so trusting it lets one
# address present itself as a new visitor on every request and walk straight through both per-IP
# limiters. The production overlay turns it on beside the Caddy that makes it true.
# GARAGE_TRUST_FORWARDED_FOR=false

# The anti-abuse bucket: the only limiter in this system that ever returns 429.
# **Zero disables it** — and note that zero means the opposite for the two budgets below, where it
# refuses every generation. A bucket of zero requests a minute is a policy nobody wants; a budget of
# zero generations is exactly how you run this site with no provider spend at all.
# GARAGE_REQUESTS_PER_MINUTE=20

# The two generation budgets. Neither ever produces an error — over either one the request is
# rebased onto retrieval, which is local and free, and the answer is marked degraded with a reason
# of its own. GENERATION_BUDGET_PER_DAY is the one worth revisiting: the free tier publishes
# something near 250 requests a day for gemini-2.5-flash, and 200 leaves headroom for retries and
# for `showcase build`. **Zero on either one refuses every generation** (see above): retrieval, the
# cache and the precomputed showcase all keep working, and every free-form answer is marked degraded.
# GARAGE_GENERATIONS_PER_DAY_PER_CLIENT=60
# GARAGE_GENERATION_BUDGET_PER_DAY=200

# The answer cache. 512 entries at a few tens of kilobytes each is around 25 MB. The TTL is not about
# correctness — the key already covers every input that changes the output, including the commit —
# it is about a visitor's reasonable expectation that a demo is not showing them yesterday.
# GARAGE_CACHE_MAX_ENTRIES=512
# GARAGE_CACHE_TTL_SECONDS=86400

# The commit this build came from. Baked into the image by the Dockerfile; set it by hand only when
# debugging. It is a cache-key component before it is a display string: without it, a deploy that
# changes the prompt keeps serving the previous build's answers under this build's version stamp.
# GARAGE_GIT_SHA=
