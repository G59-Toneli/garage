# Copy to .env and adjust. Never commit .env — see ADR-0001 (no managed services, no secrets in VCS).
# Compose loads this file; the application itself reads only the process environment.
# Every value below already has a working default, so `docker compose up` works without a .env.

# Credentials the postgres container initialises itself with.
POSTGRES_USER=garage
POSTGRES_PASSWORD=garage
POSTGRES_DB=garage

# Postgres, as reached from the application container. Compose derives this from the three
# variables above unless you override it here.
# GARAGE_DATABASE_URL=postgresql://garage:garage@postgres:5432/garage

# The manifest the service checks the database against at boot (ADR-0002). Only the catalogue is
# read, so pointing this at a real Corpus does not require mounting the material into the container.
# GARAGE_CORPUS_DIR=corpus/fixture

# The baseline embedder, a build-time axis (ADR-0005). `baseline` is the default and is what the
# dense retriever searches; `none` builds a lexical-only artifact with no vectors and no dense arm,
# which is a declaration rather than an absence. Fetch the weights once with
# `python -m garage embedder fetch` — they are 470 MB, sha256-pinned, and never committed to git.
# GARAGE_EMBEDDER=baseline
# Where those weights live. Defaults to ~/.cache/garage/embedders/multilingual-e5-small; the
# container image sets it to /opt/garage/embedder, where the Dockerfile bakes them in.
# GARAGE_EMBEDDER_DIR=

# Generation is optional. With no key the service still boots, retrieves, traces and answers with
# the chunks alone — only the `answer` field and the `generate` span go missing. Install the extra
# to use it: `pip install -e .[gemini]`.
# GARAGE_GEMINI_API_KEY=
# GARAGE_GEMINI_MODEL=gemini-2.5-flash

# Bind address for the ASGI server. GARAGE_PORT also picks the published host port.
GARAGE_HOST=0.0.0.0
GARAGE_PORT=8000
