__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
*.egg-info/
dist/
build/
# Every local variant, not just `.env` — a secret keeps its value whatever the suffix is, and
# `.env.local` is the file people reach for second (ADR-0001: no secrets in VCS). The example
# file is the deliberate exception, and it holds no secret.
.env
.env.*
!.env.example

# Worktrees the agent teams run in. They are checkouts, not source.
.claude/worktrees/

# The baseline embedder weights, 470 MB, fetched by `garage embedder fetch` and never committed
# (ADR-0008). The default location is the working directory, so it lands here on a local run.
.embedder/

# `garage serve` output when it is run detached during manual verification.
serve.log
serve.err
